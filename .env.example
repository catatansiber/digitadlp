# Salin menjadi .env lalu isi. Jangan commit file .env.

# Kata sandi basis data PostgreSQL (bebas, buat yang panjang).
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-panjang

# Admin pertama (dibuat sekali saat pertama jalan). Minimal 10 karakter.
DIGITADLP_ADMIN_USERNAME=admin
DIGITADLP_ADMIN_PASSWORD=
DIGITADLP_ADMIN_UNIT=Admin Sistem

# Kunci enkripsi file. Kosongkan agar dibuat otomatis di volume (lalu CADANGKAN).
DIGITADLP_FERNET_KEY=

# false untuk http://localhost. Set true bila dibuka lewat HTTPS.
DIGITADLP_COOKIE_SECURE=false

# Port di komputer Anda.
DIGITADLP_PORT=8000
